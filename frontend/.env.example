# Keep empty for local development so requests use the Vite proxy.
# Direct API origins require the frontend's exact origin in FastAPI FRONTEND_ORIGINS.
VITE_API_BASE_URL=

# Target used by the Vite development proxy when VITE_API_BASE_URL is empty.
# Change the port to match the FastAPI server (for example, 8001).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
