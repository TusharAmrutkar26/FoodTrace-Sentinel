APP_NAME=FoodTrace Sentinel API
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5176,http://127.0.0.1:5176
# Relative SQLite paths resolve from the backend directory. Production must use
# an absolute path on a persistent mounted volume.
DATABASE_URL=sqlite:///./foodtrace.db
# Vite uses this exact port and refuses to silently switch if it is occupied.
# Change the port here if needed; then restart both backend and frontend.
# For phone QR scans, set this to your laptop's LAN IPv4 and the Vite port.
# Example format: http://<your-laptop-lan-ip>:5176 (replace the placeholder first).
# In production, provide a stable HTTPS trace-page origin from deployment configuration.
# Add that exact origin to FRONTEND_ORIGINS as well.
PUBLIC_TRACE_BASE_URL=
TRACE_TRUST_PROCESS_LOSS_THRESHOLD_PERCENT=20
# Opaque server-side sessions; no signing secret is stored in source control.
AUTH_COOKIE_NAME=foodtrace_session
AUTH_SESSION_TTL_HOURS=12
AUTH_INVITATION_TTL_HOURS=72
# Set true behind HTTPS in production. Local HTTP development uses false.
AUTH_COOKIE_SECURE=false
